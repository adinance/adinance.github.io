<div class=\"dropdown-menu\"><a class=\"mbr-black dropdown-item\" href=\"56-1.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Annual Report</a><a class=\"mbr-black dropdown-item\" href=\"presentation-and-webcast.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Presentations &amp; Webcasts</a></div></li><li class=\"nav-item dropdown\"><a class=\"nav-link link mbr-black dropdown-toggle\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\"><strong>\n                            Coporate Governance</strong></a><div class=\"dropdown-menu\"><a class=\"mbr-black dropdown-item\" href=\"popup:#mbr-popup-c6\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-c6\" data-bs-target=\"#mbr-popup-c6\">Policy</a><a class=\"mbr-black dropdown-item\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Whistleblowing Form</a></div></li><li class=\"nav-item dropdown\"><a class=\"nav-link link mbr-black dropdown-toggle\" href=\"sustainability.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\"><strong>\n                            Sustainability</strong></a><div class=\"dropdown-menu\"><a class=\"mbr-black dropdown-item\" href=\"sustainability.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Overview</a><a class=\"mbr-black dropdown-item\" href=\"sustainability.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Economy</a><a class=\"mbr-black dropdown-item\" href=\"sustainability.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Environment</a><a class=\"mbr-black dropdown-item\" href=\"sustainability.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Social</a></div></li><li class=\"nav-item dropdown\"><a class=\"nav-link link mbr-black dropdown-toggle\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\"><strong>\n                            Info Request</strong></a><div class=\"dropdown-menu\"><a class=\"mbr-black dropdown-item\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">IR Contact</a><a class=\"mbr-black dropdown-item\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Email Alerts</a></div></li></ul>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-sm btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        EN</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
