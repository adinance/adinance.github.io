          "_anchor": "extFeatures57-ut",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@scaleImg)": {
              ".card .card-img": {
                "overflow": "hidden",
                "border-radius": "0",
                "img": {
                  "transition": "all .5s"
                },
                "&:hover": {
                  "img": {
                    "-webkit-transform": "scale3d(1.1, 1.1, 1.1)",
                    "transform": "scale3d(1.1, 1.1, 1.1)"
                  }
                }
              }
            },
            ".media-container-column": {
              "-webkit-justify-content": "flex-start",
              "justify-content": "flex-start",
              "padding": "0",
              "flex-wrap": "nowrap"
            },
            ".underline": {
              ".line": {
                "width": "2rem",
                "height": "1px",
                "background": "@underlineColor",
                "display": "inline-block"
              }
            },
            ".first-card": {
              "display": "block",
              ".card-wrapper": {
                "height": "100%"
              },
              ".card-box": {
                "background": "@firstBg",
                "padding": "2rem"
              },
              ".info-wrapper": {
                "display": "inline-flex",
                "-webkit-align-items": "center",
                "align-items": "center",
                ".mbr-iconfont": {
                  "padding-right": ".5rem",
                  "font-size": "20px"
                },
                ".info-text": {
                  "display": "inline-block",
                  "padding-right": "1rem",
                  "margin": "0"
                }
              },
              ".card-btn .btn": {
                "margin-left": "4px !important",
                "margin-right": "4px !important"
              }
            },
            ".first-row, .second-row": {
              "-webkit-flex": "1 1 50%",
              "flex": "1 1 50%",
              "margin": "0",
              ".card .card-wrapper": {
                "overflow": "hidden",
                "position": "relative",
                "display": "flex",
                "-webkit-flex-direction": "column",
                "flex-direction": "column",
                "flex": "1",
                ".card-img": {
                  "-webkit-flex": "1 1 100%",
                  "flex": "1 1 100%",
                  "img": {
                    "min-height": "100%",
                    "object-fit": "cover",
                    "object-position": "center center"
                  }
                }
              },
              "@media (max-width: 767px)": {
                "-webkit-flex-basis": "auto",
                "flex-basis": "auto",
                ".card .card-wrapper .card-img": {
                  "-webkit-flex-basis": "auto",
                  "flex-basis": "auto",
                  "img": {
                    "min-height": "0"
                  }
                }
              },
              ".caption": {
                "position": "absolute",
                "bottom": "0",
                "left": "0",
                "right": "0",
                "display": "inline-flex",
                "-webkit-justify-content": "space-around",
                "justify-content": "space-around",
                "-webkit-align-items": "center",
                "align-items": "center",
                "letter-spacing": "2px",
                ".price": {
                  "background": "@priceBg",
                  "padding": "0 .5rem"
                }
              }
            },
            ".first-child": {
              "padding-bottom": "2rem"
            },
            "@media (max-width: 991px)": {
              ".first-card": {
                "padding-bottom": "2rem"
              }
            },
            ".card-title": {
              "color": "#ffffff"
            },
            ".info-text": {
              "color": "#767676"
            },
            ".main-title": {
              "text-align": "right"
            },
            ".main-subtitle, .underline": {
              "text-align": "right"
            }
          },
          "_name": "extFeatures57",
          "_customHTML": "<section class=\"mbr-section extFeatures\" group=\"Features\" data-bg-video=\"{{bg.type == 'video'&amp;&amp;bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Show Underline\" name=\"showUnderline\" checked=\"\" condition=\"showSubtitle\">\n        <input type=\"color\" title=\"Underline Color\" name=\"underlineColor\" value=\"#232323\" condition=\"showUnderline&amp;&amp;showSubtitle\">\n        <input type=\"range\" inline=\"\" title=\"Cards Count\" name=\"cardsAmount\" min=\"1\" max=\"5\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Scale Image On Hover\" name=\"scaleImg\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Card Title\" name=\"showCardTitle\" condition=\"cardsAmount > 1\" checked=\"checked\">\n        <input type=\"checkbox\" title=\"Show Price\" name=\"showPrice\" condition=\"cardsAmount > 1\" checked=\"checked\">\n        <input type=\"color\" title=\"Price BG Color\" name=\"priceBg\" value=\"#367bba\" condition=\"showPrice&amp;&amp;cardsAmount > 1\">\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"flexDirection\" condition=\"cardsAmount > 1\">\n\n        <header>First Card Settings</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showFirstTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Info\" name=\"showInfo\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showFirstText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked=\"\">\n        <input type=\"color\" title=\"Background Color\" name=\"firstBg\" value=\"#ffffff\">\n        <header></header>\n\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background33.jpg\" parallax=\"\"> \n            <input type=\"color\" title=\"Background Color\" value=\"#efefef\" selected=\"\">\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=2jqUN6d6ZyM\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&amp;&amp;bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&amp;&amp;bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&amp;&amp;bg.type !== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <h3 class=\"mbr-section-subtitle main-subtitle mbr-fonts-style mbr-lighter align-center\" mbr-class=\"{'pb-3': !showUnderline}\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".main-subtitle, .underline\">\n            Publication</h3>\n\n        <div class=\"underline align-center pb-3\" mbr-if=\"showUnderline&amp;&amp;showSubtitle\">\n            <div class=\"line\"></div>\n        </div>\n    \n        <h2 class=\"mbr-section-title main-title mbr-fonts-style align-center pb-5\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".main-title\">\n            What's Update</h2>\n        <div class=\"row justify-content-center\">\n            <div class=\"card first-card col-12\" mbr-class=\"{'col-lg-8': cardsAmount == 1,\n                             'col-lg-6': cardsAmount > 1,\n                             'order-lg-2': flexDirection}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/home-what-update-photo-sample-600x4892.jpg\" alt=\"Mobirise\" title=\"\">\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showFirstTitle || showInfo || showFirstText || showButtons\">\n                        <h2 class=\"first-card-title mbr-fonts-style\" mbr-class=\"{'pb-3': !showInfo}\" mbr-theme-style=\"display-2\" mbr-if=\"showFirstTitle\" data-app-selector=\".first-card-title, .first-card-info\">CMO ไตรมาส 4 งานแน่น</h2>\n                        <div class=\"first-card-info pb-3\" mbr-if=\"showInfo\">\n                            <div class=\"info-wrapper\">\n                                <span mbr-icon=\"\" class=\"mbr-iconfont mbri-user\"></span>\n                                <p class=\"mbr-text info-text mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-4\" data-app-selector=\".info-text\">\n                                    100 PARTAKER\n                                </p>\n                                <span mbr-icon=\"\" class=\"mbr-iconfont mbri-briefcase\"></span>\n                                <p class=\"mbr-text info-text mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-4\" data-app-selector=\".info-text\">\n                                    CMO</p>\n                            </div>\n                        </div>\n                        <p class=\"mbr-text first-card-text mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-7\" mbr-if=\"showFirstText\" data-app-selector=\".first-card-text, .card-btn\">\n                            CMO ไตรมาส 4 งานแน่น คว้า เมกะโปรเจ็คต์ \"Siam Square Countdown 2024\" เฉลิมฉลองส่งท้ายปี</p>\n                        <div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn card-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"popup:#mbr-popup-ns\" class=\"btn btn-md btn-primary\" data-app-placeholder=\"Type Text\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-ns\" data-bs-target=\"#mbr-popup-ns\">\n                               Read More</a></div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"media-container-column col-lg-6\">\n                <div class=\"row first-row\" mbr-class=\"{'only-first-row': cardsAmount < 4}\" mbr-if=\"cardsAmount > 1\">\n                    <div class=\"card col-sm-12 col-md-6\" mbr-class=\"{'first-child': cardsAmount > 3}\" mbr-if=\"cardsAmount >= 2\">\n                        <div class=\"card-wrapper\">\n                            <div class=\"card-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/press-release-510x636.png\" alt=\"Mobirise\" title=\"\">\n                            </div>\n                            <div class=\"card-box caption mbr-white\" mbr-if=\"showCardTitle || showPrice\">\n                                <p class=\"mbr-text card-title mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                                    PRESS RELEASE</p>\n                                <p class=\"mbr-text price mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-4\" mbr-if=\"showPrice\" data-app-selector=\".price\">\n                                    <a href=\"https://cmo-group.com/investor-relations/press-releases\" class=\"text-white\">More</a></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card col-sm-12 col-md-6\" mbr-if=\"cardsAmount >= 3\" mbr-class=\"{'first-child': cardsAmount > 3}\">\n                        <div class=\"card-wrapper\">\n                            <div class=\"card-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/set-annoucement-510x636.png\" alt=\"Mobirise\" title=\"\">\n                            </div>\n                            <div class=\"card-box caption mbr-white\" mbr-if=\"showCardTitle || showPrice\">\n                                <p class=\"mbr-text card-title mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                                    NEWS CLIPPING</p>\n                                <p class=\"mbr-text price mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-4\" mbr-if=\"showPrice\" data-app-selector=\".price\"><a href=\"https://cmo-group.com/investor-relations/news-clipping\" class=\"text-white\">More</a></p>\n                            </div>\n                        </div>\n                    </div> \n                </div>\n\n                <div class=\"row second-row\" mbr-if=\"cardsAmount > 3\">\n                    <div class=\"card col-sm-12 col-md-6 pb-md-0\" mbr-if=\"cardsAmount >= 4\" mbr-class=\"{'pb-3': cardsAmount == '5'}\">\n                        <div class=\"card-wrapper\">\n                            <div class=\"card-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/news-clipping-510x636.png\" alt=\"Mobirise\" title=\"\">\n                            </div>\n                            <div class=\"card-box caption mbr-white\" mbr-if=\"showCardTitle || showPrice\">\n                                <p class=\"mbr-text card-title mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                                    SET ANNONCEMENT</p>\n                                <p class=\"mbr-text price mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-4\" mbr-if=\"showPrice\" data-app-selector=\".price\"><a href=\"https://cmo-group.com/investor-relations/set-annoucements\" class=\"text-white\">More</a></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card col-sm-12 col-md-6 pt-md-0\" mbr-if=\"cardsAmount == 5\" mbr-class=\"{'pt-3': cardsAmount == '5'}\">\n                        <div class=\"card-wrapper\">\n                            <div class=\"card-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/ir-calendar-510x636.png\" alt=\"Mobirise\" title=\"\">\n                            </div>\n                            <div class=\"card-box caption mbr-white\" mbr-if=\"showCardTitle || showPrice\">\n                                <p class=\"mbr-text card-title mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                                    IR CALENDAR\n                                </p>\n                                <p class=\"mbr-text price mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-4\" mbr-if=\"showPrice\" data-app-selector=\".price\">\n                                    <a href=\"https://cmo-group.com/investor-relations/ir-calendar\" class=\"text-white\">More</a></p>\n                            </div>\n                        </div>\n                    </div> \n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "mobirise4",
          "_cid": "uwCk5UeqVi",
