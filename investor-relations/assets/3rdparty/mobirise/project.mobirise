        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".card-img": {
              "position": "relative",
              "overflow": "hidden"
            },
            ".btn-col": {
              "margin": "auto",
              ".btn": {
                "margin": "0.4rem",
                "max-width": "100px",
                "padding": "1.8rem 0.8rem"
              }
            },
            ".line": {
              "width": "35px",
              "height": "3px",
              "display": "inline-block",
              "background": "@lineColor"
            },
            ".card-img:before": {
              "content": "''",
              "display": "block",
              "position": "absolute",
              "pointer-events": "none",
              "top": "0",
              "right": "0",
              "height": "100%",
              "left": "0",
              "background-color": "@hoverColor",
              "opacity": "0",
              "transform-origin": "right center 0",
              "transform": "perspective(100px) rotateY(-120deg)",
              "transform-style": "flat",
              "transition": "transform 0.5s ease-in-out, opacity 0.2s ease-in-out"
            },
            ".card-box": {
              "padding": "1.5rem 2rem",
              "background-color": "@cardColor",
              "box-shadow": "0 0 15px 0 rgba(0, 0, 0, 0.1)",
              "h3": {
                "font-weight": "600",
                "width": "100%",
                "display": "inline-block",
                "margin": "0",
                "line-height": "2rem"
              }
            },
            ".card-wrapper": {
              "height": "100%",
              "&:hover .card-img:before": {
                "opacity": "0.3",
                "transform": "perspective(100px) rotateY(0deg)"
              },
              "&:hover .card-title a": {
                "color": "@secondaryColor !important"
              }
            },
            ".text": {
              "color": "#767676"
            },
            ".card-title": {
              "color": "#36404c"
            },
            "H3": {
              "color": "#36404c"
            },
            "@media (max-width: 767px)": {
              ".btn-col": {
                ".btn": {
                  "margin-top": "2rem",
                  "max-width": "auto",
                  "padding": "0.8rem 0.8rem"
                }
              }
            }
          },
          "_name": "extFeatures36",
          "_customHTML": "<section class=\"extFeatures\" group=\"Features\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"9\">\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubTitle\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Show Line Title\" name=\"showLineTitle\" condition=\"showTitle\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#232323\" selected condition=\"showTitle&&showLineTitle\">\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Show Card Title\" name=\"showcardTitle\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" name=\"cardColor\" title=\"Cards Color\" value=\"#ffffff\" selected>\n        <input type=\"color\" name=\"hoverColor\" title=\"Hover Color\" value=\"#232323\" selected>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background33.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#efefef\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n\n        <div class=\"row justify-content-center pb-4\" mbr-if=\"showSubTitle || showTitle || showButtons\">\n            <div class=\"col-md-6 align-left\">\n                <h3 class=\"mbr-section-subtitle pb-2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubTitle\">\n                    Our Blogs</h3>\n                <h2 class=\"mbr-section-title mbr-bold pb-1 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .line-wrap\">Featured News</h2>\n\n                <div class=\"line-wrap\" mbr-if=\"showTitle&&showLineTitle\">\n                    <div class=\"line\"></div>\n                </div>\n            </div>\n            <div class=\"col-md-6 align-right btn-col\" mbr-if=\"showButtons\">\n                <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-sm btn-danger\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Go to Channel</a></div>\n            </div>\n        </div>\n\n        <div class=\"row justify-content-center\">\n            <div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"https://www.youtube.com/watch?v=LWVUsKoURmE\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/mobirise20241013-1133162024-10-3-11-57-8-1076x605.jpg\" alt=\"Mobirise\" title></a>\n                    </div>\n                    <div class=\"card-box align-left\" mbr-if=\"showcardTitle\">\n                        <h3 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\"><a href=\"https://www.youtube.com/watch?v=LWVUsKoURmE\" target=\"_blank\">maiFocus - เจาะลึก CMO บริษัทอีเวนต์ครบวงจรระดับประเทศ</a><br></h3>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card p-3 col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"https://www.youtube.com/watch?v=kmMj09BC8B4\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/mobirise20241013-1133162024-10-3-11-57-39-1076x605.jpg\" alt=\"Mobirise\" title></a>\n                    </div>\n                    <div class=\"card-box align-left\" mbr-if=\"showcardTitle\">\n                        <h3 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\"><a href=\"https://www.youtube.com/watch?v=kmMj09BC8B4\" target=\"_blank\">CMO ปรับแผนสู่ผู้นำธุรกิจอีเวนต์</a><br><br></h3>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card p-3 col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/17.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-box align-center\" mbr-if=\"showcardTitle\">\n                        <h3 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">\n                            <div><a href=\"https://mobiri.se/\" class=\"text-warning\">\n                                </a></div>\n                            <div><a href=\"https://mobiri.se/\" class=\"text-warning\">Main principle – stability in the\n                                    future!</a></div>\n                        </h3>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card p-3 col-12 col-md-6\" mbr-if=\"cardsAmount > 3\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/04.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-box align-center\" mbr-if=\"showcardTitle\">\n                        <h3 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\"><a href=\"https://mobiri.se/\" class=\"text-warning\">We must\n                                once again come together</a><br></h3>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
