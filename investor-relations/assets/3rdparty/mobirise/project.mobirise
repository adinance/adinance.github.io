              "font-family": "MobiriseIcons !important",
              "content": "'\\e966'",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.7rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "text-align": "center",
              "overflow": "hidden",
